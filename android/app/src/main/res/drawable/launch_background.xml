<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android while the app starts, before Flutter draws: the QueuEx
     logo on the app's green, so opening the app never flashes a blank screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_green" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
